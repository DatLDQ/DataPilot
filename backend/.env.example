# Your Anthropic API key (https://console.anthropic.com).
# Leave it empty to run in demo mode: an offline, rule-based agent with real SQL and charts, at no cost.
ANTHROPIC_API_KEY=

# Optional overrides
# DATAPILOT_MODEL=claude-opus-5-5
# DATAPILOT_EFFORT=medium          # low | medium | high | xhigh | max
# DATAPILOT_MAX_AGENT_STEPS=12
# DATAPILOT_DEMO_MODE=          # true/false to force; empty = demo only when no API key is set
# DATAPILOT_ENABLE_FALLBACKS=true  # retry refused requests on the recommended fallback model
# DATAPILOT_DATA_DIR=data
# DATAPILOT_MAX_UPLOAD_MB=50
# DATAPILOT_SQL_TIMEOUT_S=20

# Free alternatives (see README, "Other LLM providers"). Ignored while ANTHROPIC_API_KEY is set,
# unless DATAPILOT_PROVIDER says otherwise.
# GEMINI_API_KEY=                 # https://aistudio.google.com/apikey
# DATAPILOT_PROVIDER=             # claude | gemini | ollama; empty = auto
# DATAPILOT_GEMINI_MODEL=gemini-3.5-flash
# DATAPILOT_OLLAMA_BASE_URL=http://localhost:11434/v1
# DATAPILOT_OLLAMA_MODEL=qwen3:8b
